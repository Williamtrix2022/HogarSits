# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a git.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Postgres de Docker Compose expuesto en el puerto 5433 del host (5432 suele estar ocupado por un Postgres local).
DATABASE_URL=postgres://hogarsits:hogarsits@localhost:5433/hogarsits
# Días sin movimiento para marcar una solicitud como «sin seguimiento» (RN-13; por defecto 3).
# DIAS_SIN_SEGUIMIENTO=3
# Fotos de inmuebles (#27). Sin bucket, se guardan en disco (carpeta media/).
# Para usar S3: nombre del bucket y credenciales de un usuario IAM con permisos solo sobre ese bucket.
# En AWS (App Runner/EC2) no hacen falta las claves: se usa el rol IAM del servicio.
# AWS_STORAGE_BUCKET_NAME=hogarsits-fotos-dev
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

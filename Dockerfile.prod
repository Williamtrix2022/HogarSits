# syntax=docker/dockerfile:1
# Imagen de PRODUCCIÓN de HogarSits (#45). El Dockerfile de la raíz es el de desarrollo (runserver).
#
#   docker build -f Dockerfile.prod -t hogarsits:prod .
#
# Variables de entorno en tiempo de ejecución (nada de secretos dentro de la imagen):
#   SECRET_KEY, DATABASE_URL, ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS,
#   AWS_STORAGE_BUCKET_NAME, AWS_S3_REGION_NAME            (ver config/settings/prod.py)
#   RUN_MIGRATIONS=1   aplica las migraciones al arrancar (solo si hay UNA instancia)
#   PORT (8000), WEB_CONCURRENCY (2), LOG_LEVEL (INFO)
FROM python:3.14-slim

LABEL org.opencontainers.image.title="HogarSits" \
      org.opencontainers.image.description="Gestión y análisis inmobiliario (Procesos Estocásticos, U. de Córdoba)" \
      org.opencontainers.image.source="https://github.com/Williamtrix2022/HogarSits"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_SETTINGS_MODULE=config.settings.prod

WORKDIR /app

# Usuario sin privilegios: si alguien vulnera la aplicación no es root dentro del contenedor.
RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin app

# Solo las dependencias de ejecución (no pytest, ruff ni coverage). Se copian antes que el código
# para que Docker reutilice esta capa mientras no cambien los requisitos.
COPY requirements/base.txt requirements/base.txt
RUN pip install -r requirements/base.txt

COPY --chown=app:app . .
RUN sed -i 's/\r$//' scripts/entrypoint.sh && chmod +x scripts/entrypoint.sh

# Recoge los estáticos en la propia imagen (los sirve WhiteNoise). Las variables son SOLO de
# relleno para que Django arranque durante el build: no llegan a la imagen final.
RUN SECRET_KEY=solo-para-collectstatic ALLOWED_HOSTS=build DATABASE_URL=sqlite:///:memory: \
    python manage.py collectstatic --noinput && chown -R app:app /app/staticfiles

USER app
EXPOSE 8000

# La comprobación va por dentro con el Host permitido (si no, Django respondería 400).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import os, urllib.request as u; h = os.environ['ALLOWED_HOSTS'].split(',')[0]; u.urlopen(u.Request('http://127.0.0.1:%s/salud/' % os.environ.get('PORT', '8000'), headers={'Host': h}), timeout=4)"

ENTRYPOINT ["/app/scripts/entrypoint.sh"]
CMD ["sh", "-c", "exec gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers ${WEB_CONCURRENCY:-2} --timeout 60 --access-logfile - --error-logfile -"]
